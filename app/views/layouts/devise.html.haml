!!!
%html
  = render "layouts/head"

  %body
    .modal.fade{
      data: {
        controller: "disposable-modal",
        bs_backdrop: "static",
        bs_keyboard: "false"
      },
      tabindex: -1
    }
      .modal-dialog
        .modal-content
          .modal-header
            = yield(:view_title)
          .modal-body
            - if notice.present?
              .alert.alert-light{ role: "alert" }
                = notice
            - if alert.present?
              .alert.alert-warning{ role: "alert" }
                = alert
            = render "users/shared/error_messages", resource: resource
            = yield
          .modal-footer
            = render "users/shared/links"
