%body#body{ data: { controller: "home" } }

  = content_for :header_controls do
    = render "tickets_button"
  = render "shared/header", home_path: language_root_path(@language) do
    %button.btn-secondary.dropdown-toggle{
      type: "button",
      data: { bs_toggle: "dropdown" },
      aria_expanded: "false"
    }
      = t "languages.#{@language}"

    %ul.dropdown-menu
      - User::LANGUAGES.each do |language|
        - if language.to_s != @language
          %li
            %a.dropdown-item{ href: language_root_path(language:) }
              = t "languages.#{language}"

  %main.px-3
    %div
      = turbo_frame_tag "booked-lessons",
        data: { src: student_lessons_path(@language, current_user.id) }

    .d-flex.flex-row.flex-wrap.align-items-start.justify-content-center.gap-2
      .d-flex.flex-column.align-items-stretch.justify-content-start.gap-2
        .d-flex.flex-row.gap-2.text-nowrap.align-items-center
          %div レッスンを予約したい講師
          %div
            %select#instructor-filter.form-select{
              data: { action: "change->home#changeInstructorFilter" }
            }
              %option{ value: "" } (誰でもよい)
              - @instructors.each do |instructor|
                %option{
                  value: instructor.id,
                  selected: instructor.id == @initially_selected_instructor_id
                }
                  = instructor.name

        - src = calendar_lessons_path(@language)
        - instructor_src = instructor_calendar_lessons_path(@language, ":instructor_id")
        = turbo_frame_tag "lessons-calendar",
          class: "d-block flex-grow-1",
          data: { src:, instructor_src: }

      = turbo_frame_tag "lessons-slots", class: "d-block flex-grow-1 flex-shrink-0 container p-0"

  #ticket-modal.modal.fade
    .modal-dialog.modal-lg
      .modal-content
        .modal-header
          %h5.modal-title チケット
          %button.btn-close{ type: "button", data: { bs_dismiss: "modal" } }
        .modal-body
          - if current_user.tickets_count > 0
            %div= "購入済みのチケットが#{current_user.tickets_count}回分あります。"
          .buy-ticket-buttons
            - ticket_plans.each do |plan_id, plan|
              = button_to checkouts_path, params: { plan: plan_id }, data: { turbo: false }, class: "buy-ticket-button" do
                %div= plan[:label]
                .ms-auto= "#{plan[:price]}円+税"

  = content_for :toasts do
    - [ [ alert, true ], [ notice, false] ].each do |(message, alert)|
      - if message.present?
        = render "shared/toast", message:, alert:
  = render "shared/toast_container"