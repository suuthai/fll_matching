-# locals: (controller: "edit-modal", records_frame: nil, model:, url:, title: "", multipart: false, dialog_class: nil)

.modal.fade{
  data: {
    controller:,
    records_frame:,
    bs_backdrop: "static",
    bs_keyboard: "false"
  },
  tabindex: -1
}

  .modal-dialog{ class: dialog_class }
    = form_with model:,
      data: { action: "turbo:submit-start->#{controller}#submitStart" },
      class: "modal-content",
      url:,
      multipart: do |form|

      .modal-header
        .modal-title= title
        .ms-auto
          %button.btn-close{
            type: "button",
            data: { bs_dismiss: "modal" }
          }

      = yield form