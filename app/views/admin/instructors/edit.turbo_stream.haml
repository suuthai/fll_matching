= turbo_stream.append "body" do
  = render "shared/new_record_modal",
    records_frame: "instructors",
    url: admin_instructor_path(@instructor),
    model: @instructor,
    title: "講師情報の参照と更新" do |form|

    .modal-body
      #edit-instructor-errors
      .field
        = form.label :name
        = form.text_field :name, required: true, autofocus: true
      .field
        = form.label :email
        = form.email_field :email, required: true
      .field
        = form.label :password
        = form.password_field :password, placeholder: "変更する場合のみ入力してください"
      .field
        = form.label :instructional_language
        = form.select :instructional_language,
          User.instructional_languages.keys.map { |language| [t("languages.#{language}"), language] }

    .modal-footer.actions
      %button.btn-primary 更新する