= turbo_stream.append "body" do
  %div{
    data: {
      controller: "latch",
      latch_name: "update",
      latch_value: @instructor.errors.any? && "error"
    }
  }

- if @instructor.errors.empty?

  = turbo_stream.append "toasts" do
    = render "shared/toast", message: "講師情報を更新しました。"

- else

  = turbo_stream.replace "edit-instructor-errors" do
    - @instructor.errors.full_messages.each do |message|
      .alert.alert-warning{ role: "alert" }
        = message