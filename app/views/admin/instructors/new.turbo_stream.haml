= turbo_stream.append "body" do
  = render "shared/edit_modal",
    records_frame: "instructors",
    url: admin_instructors_path,
    model: @instructor,
    title: "講師の追加" do |form|

    .modal-body
      #new-instructor-errors
      .field
        = form.label :name
        = form.text_field :name, required: true, autofocus: true
      .field
        = form.label :email
        = form.email_field :email, required: true
      .field
        = form.label :password
        = form.password_field :password
      %fieldset.field
        %legend.form-label 指導可能な言語
        - User::LANGUAGES.each do |language|
          .form-check.form-check-inline
            = form.check_box "can_instruct_#{language}"
            = form.label "can_instruct_#{language}", t("languages.#{language}")

    .modal-footer.actions
      %button.btn-primary 講師を追加する
