= turbo_stream.append "body" do
  %div{ data: { controller: "latch", latch_name: "update" } }

- if @instructor.errors.empty?
  = turbo_stream.append "toasts" do
    = render "shared/toast", message: "講師 '#{@instructor.name}' を削除しました。"
- else
  = turbo_stream.append "body" do
    = render "shared/error_modal" do
      - @instructor.errors.full_messages.each do |message|
        %div= message