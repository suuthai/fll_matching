= turbo_stream.append "body" do
  %div{
    data: {
      controller: "latch",
      latch_name: "create-record",
      latch_value: !@instructor.persisted? && "error"
    }
  }

- if @instructor.persisted?

  = turbo_stream.append "toasts" do
    = render "shared/toast", message: "講師を追加しました。"

-else

  = turbo_stream.replace "new-instructor-errors" do
    - @instructor.errors.full_messages.each do |message|    
      .alert.alert-warning{ role: "alert" }
        = message
