= turbo_frame_tag "instructors" do

  .d-flex.flex-column.gap-2
    %div
      = link_to "講師を追加する", new_admin_instructor_path,
        class: "btn btn-primary",
        data: { turbo_stream: true }

    -# この判定の後にレコードをループするので、ここでは .present? を使うのが正しいはず
    - if @instructors.present?
      = form_with model: User.new, url: "", data: { turbo_stream: true } do |form|
        %table.table
          %thead
            %tr
              - [ :name, :email, :instructable_languages ].each do
                %th{ scope: :col }= User.human_attribute_name(_1)
              %th{ scope: :col }
          %tbody
            - @instructors.each do |instructor|
              %tr
                %td= instructor.name
                %td= instructor.email
                %td{ class: instructor.instructable_languages.map { |language| "language-#{language}" } }
                  = instructor.instructable_languages.map { |language| t("languages.#{language}") }.join(", ")
                %td.py-0.align-middle
                  = link_to "参照と更新", edit_admin_instructor_path(instructor),
                    class: "btn btn-primary btn-sm",
                    data: { turbo_stream: true }
                  %button{
                    class: "btn-danger btn-sm",
                    formaction: confirm_destruction_admin_instructor_path(instructor.id),
                    formmethod: :get
                  } 削除