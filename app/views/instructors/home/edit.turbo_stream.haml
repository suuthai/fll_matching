= turbo_stream.append "body" do
  = render "shared/edit_modal",
    controller: "instructors--edit-modal",
    url: instructors_update_path,
    model: current_user,
    title: "プロフィールの更新",
    multipart: true,
    dialog_class: "modal-lg" do |form|

    = form.hidden_field :time_zone, name: :time_zone, id: :time_zone, value: time_zone

    .modal-body
      #edit-profile-errors
      .row
        - if current_user.face_photo.attached?
          .col-md-4
            %div 現在の顔写真
            = image_tag current_user.face_photo, class: "rounded my-2 img-fluid", style: "aspect-ratio: 1 / 1; object-fit: cover;"
        %div{ class: current_user.face_photo.attached? ? "col-md-8" : nil }
          .field
            = form.label :face_photo, current_user.face_photo.attached? ? "更新後の顔写真" : "顔写真"
            = form.file_field :face_photo,
              accept: "image/png,image/jpeg,image/webp",
              required: !current_user.face_photo.attached?
          .field
            = form.label :name
            = form.text_field :name, required: true, autofocus: true
          .field
            = form.label :profile_text, "プロフィール"
            = form.text_area :profile_text, rows: 4, required: true
      .row
        %div
          %fieldset#instructable-languages.field.mt-2
            %legend 指導可能な言語
            - User::LANGUAGES.each do |language|
              .form-check.form-check-inline
                = form.check_box "can_instruct_#{language}"
                = form.label "can_instruct_#{language}", t("languages.#{language}")
            .constraint-message{ hidden: true }
              最低1つ以上チェックしてください
          %fieldset#lesson-slots.field
            %legend レッスン時間枠
            %table.table{ style: "table-layout: fixed;" }
              %thead
                %tr
                  %th
                  - User::LANGUAGES.each do |language|
                    %th.text-center= t("languages_short.#{language}")
              %tbody
                - time = Time.current.in_time_zone(time_zone)
                - slot_hours.each do |hour|
                  - lesson_slots_by_language = @lesson_slots_by_language_and_hour[hour] || {}
                  %tr
                    %th= l time.change(hour:), format: :lesson_slot_short
                    - User::LANGUAGES.each do |language|
                      - slot = lesson_slots_by_language[language.to_s] || current_user.lesson_slots.build(hour:, language:)
                      = form.fields_for :lesson_slots, slot do |slot_form|
                        = slot_form.hidden_field :id
                        = slot_form.hidden_field :hour
                        = slot_form.hidden_field :language, value: slot.language
                        %td.p-0.text-center
                          %label.d-block.m-0.p-2{ style: "cursor: pointer;" }
                            = slot_form.check_box :_destroy, { checked: slot.persisted? }, "0", "1"
            .constraint-message{ hidden: true }
              最低1つ以上チェックしてください

    .modal-footer.actions
      %button.btn-primary 更新する