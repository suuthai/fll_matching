= turbo_stream.append "body" do
  %div{
    data: {
      controller: "latch",
      latch_name: "update",
      latch_value: current_user.errors.any? && "error"
    }
  }

- if current_user.errors.empty?

  = turbo_stream.append "toasts" do
    = render "shared/toast", message: "プロフィールを更新しました。"

- else

  = turbo_stream.replace "edit-profile-errors" do
    - current_user.errors.full_messages.each do |message|
      .alert.alert-warning{ role: "alert" }
        = message